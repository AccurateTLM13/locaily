{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://locaily.dev/schemas/document-review-report.schema.json",
  "title": "Document Review Report Output",
  "description": "Review report assembled deterministically by document-scan task 'compose-report'.",
  "type": "object",
  "required": ["title", "doc_name", "headline", "sections", "markdown"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "doc_name": { "type": "string", "minLength": 1 },
    "headline": { "type": "string", "minLength": 1 },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["heading", "items"],
        "properties": {
          "heading": { "type": "string" },
          "items": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "markdown": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
