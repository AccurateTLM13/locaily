{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://locaily.dev/schemas/workflow-pack-manifest.schema.json",
  "title": "Workflow Pack Manifest",
  "description": "Self-contained Workflow Pack contract (pack.json) dynamically loaded by Local Brain without modifying core code.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "version",
    "trust",
    "description",
    "workflows"
  ],
  "properties": {
    "schema": {
      "const": "locaily.workflow_pack.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Unique kebab-case pack identifier."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "trust": {
      "type": "string",
      "enum": ["official", "verified", "community", "experimental", "local_private"]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/packWorkflow"
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Relative paths to .track.json files inside the pack."
    },
    "track_metadata": {
      "type": "object",
      "description": "Optional orchestration metadata keyed by track_id."
    },
    "tools": {
      "type": "string",
      "minLength": 1,
      "description": "Relative path to tool-pack manifest (e.g. tools/tool.json)."
    },
    "prompts": {
      "type": "object",
      "description": "Optional mapping of prompt template keys to relative markdown/text files inside the pack."
    },
    "schemas": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Relative paths to JSON schema files shipped in the pack."
    },
    "fixtures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/packFixture"
      }
    },
    "permissions": {
      "type": "string",
      "minLength": 1,
      "description": "Relative path to permissions declaration JSON (e.g. permissions.json)."
    },
    "qualification_requirements": {
      "type": "string",
      "minLength": 1,
      "description": "Relative path to qualification requirements JSON (e.g. qualification-requirements.json)."
    },
    "readme": {
      "type": "string",
      "minLength": 1,
      "description": "Relative path to README.md."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "packWorkflow": {
      "type": "object",
      "required": [
        "workflow_id",
        "name",
        "description",
        "input_type",
        "output_type",
        "status"
      ],
      "properties": {
        "workflow_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "track_id": {
          "type": ["string", "null"]
        },
        "composition": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/compositionEntry"
          }
        },
        "input_requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inputRequirement"
          }
        },
        "output_alias": {
          "type": ["string", "null"]
        },
        "input_type": {
          "type": "string",
          "minLength": 1
        },
        "output_type": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["implemented", "experimental", "planned"]
        },
        "intake": {
          "$ref": "#/$defs/intakeHints"
        }
      },
      "additionalProperties": false
    },
    "compositionEntry": {
      "type": "object",
      "required": ["as", "track_id"],
      "properties": {
        "as": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "track_id": {
          "type": "string",
          "minLength": 1
        },
        "requires": {
          "type": "array",
          "items": { "type": "string" }
        },
        "input_map": {
          "type": "object"
        },
        "on_failure": {
          "enum": ["abort", "skip"]
        }
      },
      "additionalProperties": false
    },
    "inputRequirement": {
      "type": "object",
      "required": ["field", "type"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["string", "number", "integer", "boolean", "array", "object"] },
        "required": { "type": "boolean" },
        "help": { "type": "string" }
      },
      "additionalProperties": false
    },
    "intakeHints": {
      "type": "object",
      "properties": {
        "keywords": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "phrases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "examples": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "input_hints": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "negative_keywords": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "packFixture": {
      "type": "object",
      "required": ["name", "workflow_id", "path"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "workflow_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "expected_fields": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  }
}
