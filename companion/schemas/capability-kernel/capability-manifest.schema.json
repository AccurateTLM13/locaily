{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://locaily.local/schemas/capability-kernel/capability-manifest.v1.json",
  "title": "Locaily Runtime Capability Manifest",
  "description": "A versioned, promotion-gated capability package contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_id",
    "version",
    "status",
    "triggers",
    "tracks",
    "permissions",
    "approval_policy",
    "final_output_schema"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "capability_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": ["draft", "tested", "reviewed", "promoted", "active", "deprecated"]
    },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_type"],
        "properties": {
          "event_type": { "type": "string" },
          "conditions": { "type": "object" }
        }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "track_id",
          "handler_type",
          "handler_id",
          "input_schema",
          "output_schema",
          "retry"
        ],
        "properties": {
          "track_id": { "type": "string", "minLength": 1 },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "handler_type": {
            "enum": ["rule", "script", "tool", "model", "human"]
          },
          "handler_id": { "type": "string", "minLength": 1 },
          "input_schema": { "type": "string", "minLength": 1 },
          "output_schema": { "type": "string", "minLength": 1 },
          "timeout_ms": { "type": "integer", "minimum": 1 },
          "retry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["max_attempts"],
            "properties": {
              "max_attempts": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "retryable_codes": {
                "type": "array",
                "items": { "type": "string" },
                "uniqueItems": true
              }
            }
          },
          "fallback_track_id": { "type": "string" }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "filesystem_write", "irreversible"],
      "properties": {
        "network": { "type": "boolean" },
        "filesystem_write": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "irreversible": { "type": "boolean" }
      }
    },
    "approval_policy": {
      "enum": ["none", "before_run", "before_irreversible"]
    },
    "final_output_schema": { "type": "string", "minLength": 1 },
    "resource_limits": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
