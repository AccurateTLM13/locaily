{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://locaily.local/schemas/capability-kernel/node-config.v1.json",
  "title": "Locaily Local NearbyNode Configuration",
  "description": "The explicit local execution boundary, trust configuration, and CTK policy snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "node_id",
    "mode",
    "trusted_sources",
    "policy"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "node_id": { "type": "string", "minLength": 1 },
    "mode": { "const": "local_only" },
    "trusted_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "adapter_id"],
        "properties": {
          "node_id": { "type": "string", "minLength": 1 },
          "adapter_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "cloud_fallback",
        "allowed_filesystem_write",
        "allow_irreversible"
      ],
      "properties": {
        "network": { "const": false },
        "cloud_fallback": { "const": false },
        "allowed_filesystem_write": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "allow_irreversible": { "type": "boolean" }
      }
    }
  }
}
