{
  "workflows": [
    {
      "workflow_id": "lighthouse_handoff",
      "name": "Lighthouse Handoff",
      "description": "First workflow target for Local Brain track-based orchestration.",
      "track_id": "website_audit.lighthouse_handoff",
      "input_type": "lighthouse_report",
      "output_type": "developer_handoff",
      "status": "implemented"
    },
    {
      "workflow_id": "dealsniper",
      "name": "DealSniper",
      "description": "Marketplace listing analysis workflow.",
      "track_id": "marketplace.dealsniper",
      "input_type": "marketplace_listing",
      "output_type": "deal_analysis",
      "status": "implemented"
    },
    {
      "workflow_id": "operator_log_discovery",
      "name": "Operator Log Opportunity Discovery",
      "description": "Inventory the Second Brain and rank evidence-backed Operator Log opportunities.",
      "track_id": "publishing.operator_log_discovery",
      "input_type": "editorial_discovery_request",
      "output_type": "editorial_opportunity_report",
      "status": "experimental"
    },
    {
      "workflow_id": "operator_log_draft",
      "name": "Operator Log Draft",
      "description": "Draft validated Operator Log HTML from a human-selected opportunity and evidence packet.",
      "track_id": "publishing.operator_log_draft",
      "input_type": "selected_editorial_opportunity",
      "output_type": "operator_log_html_proposal",
      "status": "experimental"
    },
    {
      "workflow_id": "repo_review",
      "name": "Repo Review",
      "description": "CORE-01 multi-track composition proof: scan a repository, then reuse the generic classify, prioritize, and summarize capability tracks before producing a domain-specific developer handoff.",
      "input_type": "repository_request",
      "output_type": "developer_handoff",
      "status": "implemented",
      "output_alias": "handoff",
      "input_requirements": [
        { "field": "path", "type": "string", "required": false, "help": "Local repository directory (read-only scan) — or send an inline files[] manifest instead." },
        { "field": "files", "type": "array", "required": false, "help": "Inline manifest [{path, lines?, todo_count?}] for offline/hermetic runs." },
        { "field": "findings", "type": "array", "required": false, "help": "Caller-provided findings merged with deterministic scan heuristics." }
      ],
      "composition": [
        { "as": "scan", "track_id": "repo_review.scan" },
        {
          "as": "classify",
          "on_failure": "skip",
          "track_id": "core.classify",
          "input_map": {
            "text": "$artifacts.scan.summary_text",
            "categories": { "$literal": ["correctness", "performance", "security", "maintainability", "documentation"] }
          }
        },
        {
          "as": "prioritize",
          "on_failure": "skip",
          "track_id": "core.prioritize",
          "input_map": {
            "items": "$artifacts.scan.findings",
            "score_fields": { "$literal": [
              { "field": "severity", "weight": 2 },
              { "field": "effort", "weight": -1 }
            ] },
            "tie_break": "id",
            "limit": 12
          }
        },
        {
          "as": "summarize",
          "track_id": "core.summarize",
          "input_map": {
            "text": "$artifacts.scan.summary_text",
            "style": "developer-brief",
            "max_points": 5
          }
        },
        {
          "as": "handoff",
          "track_id": "repo_review.handoff",
          "requires": ["prioritize", "summarize"],
          "input_map": {
            "scan": "$artifacts.scan",
            "classification": "$artifacts.classify",
            "ranked": "$artifacts.prioritize",
            "summary": "$artifacts.summarize"
          }
        }
      ]
    },
    {
      "workflow_id": "text_qa",
      "name": "Text QA Pass",
      "description": "CORE-01 pure-reuse composition proof: extract, classify, and validate arbitrary caller text using only shared generic capability tracks. Domain content stays entirely in the workflow input.",
      "input_type": "text_qa_request",
      "output_type": "text_qa_report",
      "status": "experimental",
      "output_alias": "check",
      "input_requirements": [
        { "field": "text", "type": "string", "required": true, "help": "Send the text to check." },
        { "field": "categories", "type": "array", "required": true, "help": "Caller-defined classification categories." },
        { "field": "expected_schema", "type": "object", "required": true, "help": "JSON Schema the extracted data must satisfy." }
      ],
      "composition": [
        {
          "as": "extract",
          "track_id": "core.extract",
          "input_map": {
            "text": "$input.text",
            "schema": "$input.expected_schema"
          }
        },
        {
          "as": "classify",
          "track_id": "core.classify",
          "input_map": {
            "text": "$input.text",
            "categories": "$input.categories"
          }
        },
        {
          "as": "check",
          "track_id": "core.validate",
          "input_map": {
            "data": "$artifacts.extract.data",
            "schema": "$input.expected_schema"
          }
        }
      ]
    },
    {
      "workflow_id": "document_review",
      "name": "Document Review",
      "description": "CORE-01 documents/OCR problem-class proof: ingest a local text document (deterministic), then reuse the generic extract, classify, summarize, and validate capability tracks before assembling a review report. Image/PDF ingestion fails closed with OCR_ADAPTER_REQUIRED pending a concrete OCR adapter decision.",
      "input_type": "document_review_request",
      "output_type": "document_review_report",
      "status": "implemented",
      "output_alias": "report",
      "input_requirements": [
        { "field": "path", "type": "string", "required": false, "help": "Local .md/.txt document path — or send inline content instead." },
        { "field": "content", "type": "string", "required": false, "help": "Inline document text." },
        { "field": "doc_categories", "type": "array", "required": true, "help": "Caller-defined document categories for the shared classify capability." },
        { "field": "document_schema", "type": "object", "required": true, "help": "JSON Schema the extracted fields must satisfy (drives shared extract + validate)." }
      ],
      "composition": [
        { "as": "ingest", "track_id": "document_review.ingest" },
        {
          "as": "extract",
          "track_id": "core.extract",
          "input_map": {
            "text": "$artifacts.ingest.cleaned_text",
            "schema": "$input.document_schema"
          }
        },
        {
          "as": "classify",
          "track_id": "core.classify",
          "input_map": {
            "text": "$artifacts.ingest.cleaned_text",
            "categories": "$input.doc_categories"
          }
        },
        {
          "as": "summarize",
          "track_id": "core.summarize",
          "input_map": {
            "text": "$artifacts.ingest.cleaned_text",
            "style": "review-brief",
            "max_points": 5
          }
        },
        {
          "as": "validate",
          "track_id": "core.validate",
          "input_map": {
            "data": "$artifacts.extract.data",
            "schema": "$input.document_schema"
          }
        },
        {
          "as": "report",
          "track_id": "document_review.report",
          "requires": ["extract", "validate"],
          "input_map": {
            "document": "$artifacts.ingest",
            "extraction": "$artifacts.extract",
            "classification": "$artifacts.classify",
            "validation": "$artifacts.validate",
            "summary": "$artifacts.summarize"
          }
        }
      ]
    },
    {
      "workflow_id": "content_os",
      "name": "Content OS",
      "description": "CORE-01 content/text problem-class proof: local document -> ingest (shared with Document Review) -> extract -> classify -> summarize -> transform -> validate -> deterministic publish-prep. Five of seven composed tracks are shared capability tracks.",
      "input_type": "content_publish_request",
      "output_type": "publish_package",
      "status": "implemented",
      "output_alias": "publish",
      "input_requirements": [
        { "field": "path", "type": "string", "required": false, "help": "Local .md/.txt document path — or send inline content." },
        { "field": "content", "type": "string", "required": false, "help": "Inline document text." },
        { "field": "content_categories", "type": "array", "required": true, "help": "Caller-defined content categories for the shared classify capability." },
        { "field": "content_schema", "type": "object", "required": true, "help": "JSON Schema describing fields to extract from the document." },
        { "field": "publish_mapping", "type": "object", "required": true, "help": "Declarative transform.map spec producing publish fields from the extraction." },
        { "field": "publish_schema", "type": "object", "required": true, "help": "JSON Schema the transformed publish payload must satisfy (shared validate gate)." }
      ],
      "composition": [
        { "as": "ingest", "track_id": "document_review.ingest" },
        {
          "as": "extract",
          "track_id": "core.extract",
          "input_map": {
            "text": "$artifacts.ingest.cleaned_text",
            "schema": "$input.content_schema"
          }
        },
        {
          "as": "classify",
          "track_id": "core.classify",
          "input_map": {
            "text": "$artifacts.ingest.cleaned_text",
            "categories": "$input.content_categories"
          }
        },
        {
          "as": "summarize",
          "track_id": "core.summarize",
          "input_map": {
            "text": "$artifacts.ingest.cleaned_text",
            "style": "publish-description",
            "max_points": 4
          }
        },
        {
          "as": "transform",
          "track_id": "core.transform",
          "input_map": {
            "source": "$artifacts.extract.data",
            "mapping": "$input.publish_mapping"
          }
        },
        {
          "as": "validate",
          "track_id": "core.validate",
          "input_map": {
            "data": "$artifacts.transform.result",
            "schema": "$input.publish_schema"
          }
        },
        {
          "as": "publish",
          "track_id": "content_os.publish",
          "requires": ["validate"],
          "input_map": {
            "document": "$artifacts.ingest",
            "transformed": "$artifacts.transform",
            "classification": "$artifacts.classify",
            "summary": "$artifacts.summarize",
            "validation": "$artifacts.validate"
          }
        }
      ]
    }
  ]
}
