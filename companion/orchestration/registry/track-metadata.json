{
  "website_audit.lighthouse_handoff": {
    "purpose": "Convert Lighthouse or PageSpeed data into structured developer handoff notes for coding agents.",
    "input_type": "lighthouse_report",
    "output_type": "developer_handoff",
    "preferred_worker_type": "priority_helper",
    "fallback_behavior": "deterministic_tool_steps_when_runtime_unavailable",
    "validation_expectations": {
      "output_schema": "companion/schemas/lighthouse-handoff.schema.json",
      "verification_step": "verify_output",
      "required_result_sections": [
        "clientSummary",
        "developerSummary",
        "priorityFixes",
        "handoffChecklist",
        "estimatedImpact",
        "markdown"
      ]
    }
  },
  "marketplace.dealsniper": {
    "purpose": "Analyze marketplace listings and return a structured deal assessment.",
    "input_type": "marketplace_listing",
    "output_type": "deal_analysis",
    "preferred_worker_type": "default_worker",
    "fallback_behavior": "fail_when_runtime_unavailable",
    "validation_expectations": {
      "output_schema": null,
      "verification_step": "validate_analysis",
      "required_result_sections": ["summary", "dealScore", "meta"]
    }
  },
  "publishing.operator_log_discovery": {
    "purpose": "Inventory the allowlisted Second Brain and rank source-linked Operator Log opportunities.",
    "input_type": "editorial_discovery_request",
    "output_type": "editorial_opportunity_report",
    "preferred_worker_type": "reasoning_worker",
    "fallback_behavior": "fail_when_runtime_or_memory_unavailable",
    "validation_expectations": {
      "output_schema": "companion/schemas/editorial-opportunity-report.schema.json",
      "verification_step": "verify_report",
      "required_result_sections": ["summary", "recommendedOpportunity", "opportunities"]
    }
  },
  "publishing.operator_log_draft": {
    "purpose": "Turn a selected evidence-backed opportunity into reviewable Operator Log HTML and sitemap proposals.",
    "input_type": "selected_editorial_opportunity",
    "output_type": "operator_log_html_proposal",
    "preferred_worker_type": "default_worker",
    "fallback_behavior": "fail_when_runtime_unavailable",
    "validation_expectations": {
      "output_schema": "companion/schemas/operator-log-draft.schema.json",
      "verification_step": "verify_draft",
      "required_result_sections": ["headline", "slug", "html", "sitemapEntry"]
    }
  },
  "core.classify": {
    "purpose": "Assign one caller-defined category to a text payload (reusable classify capability).",
    "input_type": "text_classification_request",
    "output_type": "classification",
    "preferred_worker_type": "default_worker",
    "fallback_behavior": "fail_when_runtime_unavailable",
    "validation_expectations": {
      "output_schema": "tool-packs/standard-text-pack/schemas/text.classify.output.schema.json",
      "verification_step": null,
      "required_result_sections": ["category", "confidence", "reason"]
    }
  },
  "core.summarize": {
    "purpose": "Compress caller-supplied text into a bounded structured summary (reusable summarize capability).",
    "input_type": "summarization_request",
    "output_type": "summary",
    "preferred_worker_type": "default_worker",
    "fallback_behavior": "fail_when_runtime_unavailable",
    "validation_expectations": {
      "output_schema": "tool-packs/standard-text-pack/schemas/text.summarize.output.schema.json",
      "verification_step": null,
      "required_result_sections": ["summary", "key_points"]
    }
  },
  "core.extract": {
    "purpose": "Extract a caller-defined JSON structure from text (reusable extract capability).",
    "input_type": "extraction_request",
    "output_type": "extraction",
    "preferred_worker_type": "default_worker",
    "fallback_behavior": "fail_when_runtime_unavailable",
    "validation_expectations": {
      "output_schema": "tool-packs/standard-text-pack/schemas/text.extract_json.output.schema.json",
      "verification_step": null,
      "required_result_sections": ["data", "missing_fields", "confidence"]
    }
  },
  "core.validate": {
    "purpose": "Validate any payload against a caller-supplied JSON Schema (reusable deterministic validation capability and verification gate).",
    "input_type": "validation_request",
    "output_type": "verification",
    "preferred_worker_type": "tool_only",
    "fallback_behavior": "deterministic_tool_steps_when_runtime_unavailable",
    "validation_expectations": {
      "output_schema": "tool-packs/standard-text-pack/schemas/text.validate_schema.output.schema.json",
      "verification_step": "validate",
      "required_result_sections": ["valid", "errors"]
    }
  },
  "core.prioritize": {
    "purpose": "Rank caller items by weighted numeric score fields deterministically (reusable prioritize capability).",
    "input_type": "ranking_request",
    "output_type": "ranked_items",
    "preferred_worker_type": "tool_only",
    "fallback_behavior": "deterministic_tool_steps_when_runtime_unavailable",
    "validation_expectations": {
      "output_schema": null,
      "verification_step": null,
      "required_result_sections": ["ranked", "scores", "strategy"]
    }
  },
  "repo_review.scan": {
    "purpose": "Deterministic read-only repository structure extraction for the Repo Review workflow.",
    "input_type": "repository_request",
    "output_type": "repo_structure",
    "preferred_worker_type": "tool_only",
    "fallback_behavior": "deterministic_tool_steps_when_runtime_unavailable",
    "validation_expectations": {
      "output_schema": "companion/schemas/repo-structure.schema.json",
      "verification_step": null,
      "required_result_sections": ["repo_name", "file_count", "findings", "summary_text"]
    }
  },
  "repo_review.handoff": {
    "purpose": "Assemble Repo Review upstream artifacts into a developer handoff with markdown.",
    "input_type": "repo_review_artifacts",
    "output_type": "developer_handoff",
    "preferred_worker_type": "tool_only",
    "fallback_behavior": "deterministic_tool_steps_when_runtime_unavailable",
    "validation_expectations": {
      "output_schema": "companion/schemas/repo-review-handoff.schema.json",
      "verification_step": null,
      "required_result_sections": ["title", "repo_name", "headline", "priorities", "markdown"]
    }
  }
}
