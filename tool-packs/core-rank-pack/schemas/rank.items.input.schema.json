{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://locaily.dev/tool-packs/core-rank-pack/rank.items.input.schema.json",
  "title": "rank.items input",
  "type": "object",
  "required": ["items", "score_fields"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "score_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["field"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "weight": { "type": "number" }
        },
        "additionalProperties": false
      }
    },
    "tie_break": { "type": "string" },
    "limit": { "type": "integer", "minimum": 1 },
    "ascending": { "type": "boolean" }
  },
  "additionalProperties": false
}
