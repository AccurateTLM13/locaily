{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meeting Action Brief Assembly Output",
  "type": "object",
  "required": ["title", "meeting_title", "meeting_date", "category", "attendees", "decisions", "action_items", "blockers", "open_questions", "summary", "markdown"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "meeting_title": { "type": "string", "minLength": 1 },
    "meeting_date": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "attendees": { "type": "array", "items": { "type": "string" } },
    "decisions": { "type": "array", "items": { "type": "string" } },
    "action_items": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "string", "minLength": 1 },
    "markdown": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
