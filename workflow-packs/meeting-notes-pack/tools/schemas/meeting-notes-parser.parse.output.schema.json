{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meeting Notes Parse Output",
  "type": "object",
  "required": ["meeting_title", "meeting_date", "attendees", "decisions", "blockers", "open_questions", "action_items", "summary_text"],
  "properties": {
    "meeting_title": { "type": "string", "minLength": 1 },
    "meeting_date": { "type": "string", "minLength": 1 },
    "attendees": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "decisions": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "action_items": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "summary_text": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
