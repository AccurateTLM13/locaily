{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://locaily.dev/packs/ci-failure-triage-pack/schemas/ci-triage-brief.schema.json",
  "title": "CI Failure Triage Brief",
  "type": "object",
  "required": [
    "title",
    "job_name",
    "runner_os",
    "category",
    "exit_code",
    "failing_tests",
    "error_signatures",
    "likely_flake",
    "summary",
    "debug_steps",
    "markdown"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "job_name": { "type": "string", "minLength": 1 },
    "runner_os": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "exit_code": { "type": "integer" },
    "failing_tests": { "type": "array", "items": { "type": "string" } },
    "stack_locations": { "type": "array", "items": { "type": "string" } },
    "error_signatures": { "type": "array", "items": { "type": "string" } },
    "likely_flake": { "type": "boolean" },
    "summary": { "type": "string", "minLength": 1 },
    "debug_steps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "markdown": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
