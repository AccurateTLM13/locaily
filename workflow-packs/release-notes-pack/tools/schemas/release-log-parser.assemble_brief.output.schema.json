{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release Notes Brief Assembly Output",
  "type": "object",
  "required": ["title", "version", "release_type", "category", "breaking_changes", "highlights", "features", "fixes", "upgrade_notes", "summary", "markdown"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "previous_version": { "type": "string" },
    "release_type": { "type": "string", "enum": ["major", "minor", "patch"] },
    "category": { "type": "string", "minLength": 1 },
    "breaking_changes": { "type": "array", "items": { "type": "string" } },
    "highlights": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "features": { "type": "array", "items": { "type": "string" } },
    "fixes": { "type": "array", "items": { "type": "string" } },
    "other_changes": { "type": "array", "items": { "type": "string" } },
    "upgrade_notes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "summary": { "type": "string", "minLength": 1 },
    "markdown": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
