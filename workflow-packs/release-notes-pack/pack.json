{
  "schema": "locaily.workflow_pack.v1",
  "id": "release-notes-pack",
  "name": "Release Notes & Changelog Pack",
  "version": "1.0.0",
  "trust": "official",
  "description": "Read-only Workflow Pack that parses conventional commits and merged PR summaries, detects breaking changes and semver impact, classifies the release via core.classify, summarizes highlights via core.summarize, and assembles a structured changelog.",
  "author": "Locaily",
  "license": "MIT",
  "workflows": [
    {
      "workflow_id": "release_notes",
      "name": "Release Notes & Changelog Brief",
      "description": "Parse conventional commit logs and merged PR references deterministically, detect breaking changes, classify release type, and assemble a release changelog draft.",
      "input_type": "commit_log_request",
      "output_type": "release_notes_brief",
      "status": "implemented",
      "output_alias": "brief",
      "input_requirements": [
        {
          "field": "commits_text",
          "type": "string",
          "required": true,
          "help": "Commit log messages, merged PR bullets, or milestone notes."
        },
        {
          "field": "version",
          "type": "string",
          "required": false,
          "help": "Optional target version tag (e.g. v0.7.0)."
        },
        {
          "field": "previous_version",
          "type": "string",
          "required": false,
          "help": "Optional previous version tag for comparison context."
        }
      ],
      "intake": {
        "keywords": [
          "changelog",
          "release notes",
          "commits",
          "semver",
          "breaking changes",
          "upgrade notes",
          "merged prs",
          "version bump",
          "release draft"
        ],
        "phrases": [
          "generate release notes",
          "write changelog",
          "draft release notes",
          "changelog from commits",
          "summarize merged prs",
          "prepare changelog"
        ],
        "examples": [
          "Generate release notes and a categorized changelog from these conventional commits",
          "Draft upgrade notes and breaking-change callouts for v0.7.0 from merged PRs"
        ],
        "input_hints": [
          "commits_text",
          "version",
          "previous_version"
        ],
        "negative_keywords": [
          "lighthouse",
          "dealsniper",
          "incident",
          "outage",
          "content os",
          "publish package",
          "syndication",
          "meeting",
          "bug report",
          "ci failure",
          "git diff"
        ]
      },
      "composition": [
        {
          "as": "parse",
          "track_id": "release_notes.parse",
          "input_map": {
            "commits_text": "$input.commits_text",
            "version": "$input.version",
            "previous_version": "$input.previous_version"
          }
        },
        {
          "as": "classify",
          "on_failure": "skip",
          "track_id": "core.classify",
          "input_map": {
            "text": "$artifacts.parse.summary_text",
            "categories": {
              "$literal": [
                "major_release",
                "minor_feature_release",
                "patch_bugfix_release",
                "security_release",
                "maintenance_release"
              ]
            }
          }
        },
        {
          "as": "summarize",
          "track_id": "core.summarize",
          "input_map": {
            "text": "$artifacts.parse.summary_text",
            "style": "release-changelog",
            "max_points": 5
          }
        },
        {
          "as": "brief",
          "track_id": "release_notes.brief",
          "requires": ["parse", "summarize"],
          "input_map": {
            "parsed": "$artifacts.parse",
            "classification": "$artifacts.classify",
            "summary": "$artifacts.summarize"
          }
        }
      ]
    }
  ],
  "tracks": [
    "tracks/release_notes.parse.track.json",
    "tracks/release_notes.brief.track.json"
  ],
  "track_metadata": {
    "release_notes.parse": {
      "purpose": "Deterministically group conventional commits, breaking changes, PR refs, and recommended semver bump from commit logs.",
      "input_type": "commit_log_request",
      "output_type": "parsed_release_commits",
      "preferred_worker_type": "tool_only",
      "fallback_behavior": "deterministic_tool",
      "validation_expectations": {
        "output_schema": "tools/schemas/release-log-parser.parse.output.schema.json",
        "required_result_sections": ["version", "release_type", "breaking_changes", "features", "fixes", "summary_text"]
      }
    },
    "release_notes.brief": {
      "purpose": "Assemble parsed commits, classification, and summary into a structured changelog and upgrade guide.",
      "input_type": "release_notes_brief_inputs",
      "output_type": "release_notes_brief",
      "preferred_worker_type": "tool_only",
      "fallback_behavior": "deterministic_tool",
      "validation_expectations": {
        "output_schema": "schemas/release-notes-brief.schema.json",
        "required_result_sections": ["title", "version", "release_type", "category", "breaking_changes", "highlights", "features", "fixes", "upgrade_notes", "summary", "markdown"]
      }
    }
  },
  "tools": "tools/tool.json",
  "prompts": {
    "release_notes_summary": "prompts/release-notes-summary.md"
  },
  "schemas": [
    "schemas/release-notes-brief.schema.json",
    "tools/schemas/release-log-parser.parse.input.schema.json",
    "tools/schemas/release-log-parser.parse.output.schema.json",
    "tools/schemas/release-log-parser.assemble_brief.input.schema.json",
    "tools/schemas/release-log-parser.assemble_brief.output.schema.json"
  ],
  "fixtures": [
    {
      "name": "Sample Conventional Commit Release Log",
      "workflow_id": "release_notes",
      "path": "fixtures/sample-commit-log.json",
      "expected_fields": ["title", "version", "release_type", "category", "breaking_changes", "highlights", "features", "fixes", "upgrade_notes", "summary", "markdown"]
    }
  ],
  "permissions": "permissions.json",
  "qualification_requirements": "qualification-requirements.json",
  "readme": "README.md"
}
