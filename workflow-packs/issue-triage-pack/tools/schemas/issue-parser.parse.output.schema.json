{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Issue Parse Output",
  "type": "object",
  "required": ["issue_title", "reporter", "has_repro_steps", "environment", "subsystems", "missing_info_questions", "triage_signals", "summary_text"],
  "properties": {
    "issue_title": { "type": "string", "minLength": 1 },
    "reporter": { "type": "string", "minLength": 1 },
    "has_repro_steps": { "type": "boolean" },
    "has_expected_actual": { "type": "boolean" },
    "environment": { "type": "string", "minLength": 1 },
    "subsystems": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "missing_info_questions": { "type": "array", "items": { "type": "string" } },
    "triage_signals": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "summary_text": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
