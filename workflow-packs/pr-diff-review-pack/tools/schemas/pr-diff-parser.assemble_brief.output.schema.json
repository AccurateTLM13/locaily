{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PR Review Brief Assembly Output",
  "type": "object",
  "required": ["title", "pr_title", "base_branch", "category", "files_changed", "sensitive_files", "top_risks", "review_checklist", "suggested_tests", "summary", "markdown"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "pr_title": { "type": "string", "minLength": 1 },
    "base_branch": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "files_changed": { "type": "array", "items": { "type": "string" } },
    "total_additions": { "type": "integer", "minimum": 0 },
    "total_deletions": { "type": "integer", "minimum": 0 },
    "sensitive_files": { "type": "array", "items": { "type": "string" } },
    "top_risks": { "type": "array", "items": { "type": "object" } },
    "review_checklist": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "suggested_tests": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "summary": { "type": "string", "minLength": 1 },
    "markdown": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
