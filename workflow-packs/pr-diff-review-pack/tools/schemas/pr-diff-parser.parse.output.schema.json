{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PR Diff Parse Output",
  "type": "object",
  "required": ["pr_title", "base_branch", "files_changed", "total_additions", "total_deletions", "sensitive_files", "risk_items", "summary_text"],
  "properties": {
    "pr_title": { "type": "string", "minLength": 1 },
    "base_branch": { "type": "string", "minLength": 1 },
    "files_changed": { "type": "array", "items": { "type": "string" } },
    "total_additions": { "type": "integer", "minimum": 0 },
    "total_deletions": { "type": "integer", "minimum": 0 },
    "sensitive_files": { "type": "array", "items": { "type": "string" } },
    "risk_items": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "summary_text": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
