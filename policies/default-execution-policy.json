{
  "version": "1.0.0",
  "status": "enforced",
  "defaultDecision": "deny",
  "actions": {
    "filesystem.read.workspace": "allow",
    "filesystem.write.workspace": "allow",
    "filesystem.read.outside_workspace": "require_approval",
    "filesystem.write.outside_workspace": "require_approval",
    "filesystem.read.config": "require_approval",
    "filesystem.write.config": "require_approval",
    "filesystem.delete": "require_approval",
    "filesystem.delete.protected": "deny",
    "shell.execute.approved": "require_approval",
    "shell.execute.arbitrary": "deny",
    "browser.open.local": "allow",
    "browser.open.external": "require_approval",
    "network.local": "require_approval",
    "network.external": "require_approval",
    "model.run": "allow",
    "tool.execute.deterministic": "allow",
    "credentials.read": "deny",
    "credentials.write": "deny",
    "credentials.pass.external": "deny",
    "memory.read": "allow",
    "memory.writeback.propose": "allow",
    "memory.writeback.apply": "require_approval",
    "memory.delete": "deny",
    "nearbyNode.register": "require_approval",
    "nearbyNode.invoke": "require_approval",
    "nearbyNode.invoke.unregistered": "deny",
    "audit.disable": "deny",
    "audit.delete": "deny",
    "policy.modify.runtime": "deny",
    "software.install.system": "deny",
    "software.download_execute": "deny",
    "publish.external": "require_approval",
    "publish.social": "deny"
  }
}
